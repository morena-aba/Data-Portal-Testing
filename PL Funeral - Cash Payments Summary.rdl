      </ConnectionProperties>
      <rd:DataSourceID>8058ae15-6641-40a6-ad18-9417034ebc7b</rd:DataSourceID>
      <rd:PowerBIWorkspaceName>Abacus Data Portal</rd:PowerBIWorkspaceName>
