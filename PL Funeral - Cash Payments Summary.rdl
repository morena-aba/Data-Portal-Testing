  </DataSources>
  <DataSets>
    <DataSet Name="FinancialMonth">
      <Query>
        <DataSourceName>AbacusDataPortal_CashPayments_Bodereaux</DataSourceName>
        <CommandText>EVALUATE
ADDCOLUMNS (
    SUMMARIZECOLUMNS ( 'CashPayments'[FinancialMonth2] ),
    "MonthText", FORMAT ( 'CashPayments'[FinancialMonth2], "MMMM yyyy")
)
ORDER BY 'CashPayments'[FinancialMonth2] DESC</CommandText>
      </Query>
      <Fields>
        <Field Name="FinancialMonth2">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>CashPayments[FinancialMonth2]</DataField>
        </Field>
        <Field Name="MonthText">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>[MonthText]</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="LatestMonth">
      <Query>
        <DataSourceName>AbacusDataPortal_CashPayments_Bodereaux</DataSourceName>
        <CommandText>EVALUATE
TOPN (
    1,
    ADDCOLUMNS (
        SUMMARIZECOLUMNS ( 'CashPayments'[FinancialMonth2] ),
        "MonthText", FORMAT ( 'CashPayments'[FinancialMonth2], "MMMM yyyy" )
    ),
    'CashPayments'[FinancialMonth2], DESC
)</CommandText>
      </Query>
      <Fields>
        <Field Name="FinancialMonth2">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>CashPayments[FinancialMonth2]</DataField>
        </Field>
        <Field Name="MonthText">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>[MonthText]</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Summary">
      <Query>
        <DataSourceName>AbacusDataPortal_CashPayments_Bodereaux</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="StartMonth">
            <rd:UserDefined>true</rd:UserDefined>
            <Value>=Parameters!StartMonth.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>EVALUATE
SUMMARIZECOLUMNS(
    'CashPayments'[New_Retailer],

    KEEPFILTERS(
        FILTER(
            ALL('CashPayments'[FinancialMonth2]),
            EOMONTH('CashPayments'[FinancialMonth2],0)
                = EOMONTH(@StartMonth,0)
        )
    ),

    "Sum of Premium",
        SUMX('CashPayments', INT('CashPayments'[Amount])),

    "Sum of Policies",
        COUNT('CashPayments'[PolicyNumber]),

    "Reporting_Date",
        MIN('CashPayments'[FinancialMonth2])
)
ORDER BY
    'CashPayments'[New_Retailer]</CommandText>
      </Query>
      <Fields>
        <Field Name="Retailer">
          <rd:UserDefined>true</rd:UserDefined>
          <DataField>CashPayments[Retailer]</DataField>
        </Field>
        <Field Name="ID_Sum_of_Premium_">
          <rd:TypeName>System.Int64</rd:TypeName>
          <DataField>[Sum of Premium]</DataField>
        </Field>
        <Field Name="ID_Sum_of_Policies_">
          <rd:TypeName>System.Int64</rd:TypeName>
          <DataField>[Sum of Policies]</DataField>
        </Field>
        <Field Name="ID_Reporting_Date_">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>[Reporting_Date]</DataField>
        </Field>
        <Field Name="New_Retailer">
          <rd:UserDefined>true</rd:UserDefined>
          <DataField>CashPayments[New_Retailer]</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
