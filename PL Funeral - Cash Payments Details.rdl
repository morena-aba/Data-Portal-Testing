    <DataSet Name="FinancialMonth">
      <Query>
        <DataSourceName>AbacusDataPortal_CashPayments_Bodereaux</DataSourceName>
        <CommandText>EVALUATE
ADDCOLUMNS (
    SUMMARIZECOLUMNS ( 'CashPayments'[FinancialMonth2] ),
    "MonthText", FORMAT ( 'CashPayments'[FinancialMonth2], "MMMM yyyy")
)
ORDER BY 'CashPayments'[FinancialMonth2] DESC</CommandText>
      </Query>
      <Fields>
        <Field Name="FinancialMonth2">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>CashPayments[FinancialMonth2]</DataField>
        </Field>
        <Field Name="MonthText">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>[MonthText]</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="LatestMonth">
      <Query>
        <DataSourceName>AbacusDataPortal_CashPayments_Bodereaux</DataSourceName>
        <CommandText>EVALUATE
TOPN (
    1,
    ADDCOLUMNS (
        SUMMARIZECOLUMNS ( 'CashPayments'[FinancialMonth2] ),
        "MonthText", FORMAT ( 'CashPayments'[FinancialMonth2], "MMMM yyyy" )
    ),
    'CashPayments'[FinancialMonth2], DESC
)</CommandText>
      </Query>
      <Fields>
        <Field Name="FinancialMonth2">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>CashPayments[FinancialMonth2]</DataField>
        </Field>
        <Field Name="MonthText">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>[MonthText]</DataField>
        </Field>
      </Fields>
    </DataSet>
